 impl LocalSourceActivity {
+    /// Smooth already admitted members, including single-cell frames on
+    /// different neighbors. Whole-work admission alone permits all of their
+    /// bytes at once. Primary and neutral transit never enter this method.
+    pub(crate) fn pace_lossy_packet(
+        &self,
+        cell: &veil_types::local_lossy_work::LocalLossyCell,
+        bytes: usize,
+        now: Instant,
+    ) -> veil_types::local_lossy_work::WorkAdmission {
+        cell.pace_packet_at(self.work_owner, bytes, now, |cost| {
+            let mut state = lock!(self.state);
+            let active_until = state.last_primary.map(|at| at + IDLE_GRACE);
+            let Some(active_until) = active_until.filter(|until| now < *until) else {
+                state.secondary_packet_next = None;
+                return Ok(());
+            };
+            let Some(pressure_until) = state.pressure_until.filter(|until| now < *until) else {
+                return Ok(());
+            };
+            if let Some(next) = state.secondary_packet_next.filter(|next| now < *next) {
+                return Err(next.min(active_until).min(pressure_until));
+            }
+            let nanos = (cost as u128)
+                .saturating_mul(SECONDARY_PROBE_INTERVAL.as_nanos())
+                .div_ceil(LOSSY_SECONDARY_BYTES as u128);
+            let charge = Duration::from_nanos(nanos.min(u64::MAX as u128) as u64);
+            state.secondary_packet_next = Some(now + charge);
+            Ok(())
+        })
+    }
