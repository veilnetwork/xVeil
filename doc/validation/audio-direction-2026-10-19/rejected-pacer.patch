+    /// Pace one admitted member across the endpoint's competing producers.
+    /// A scheduler retry keeps its original reservation, deadline and charge;
+    /// waiting here must not reject the already admitted complete work.
+    pub fn pace_packet_at(
+        &self,
+        owner: u64,
+        wire_bytes: usize,
+        now: Instant,
+        reserve: impl FnOnce(usize) -> Result<(), Instant>,
+    ) -> WorkAdmission {
+        let mut state = self.work.decision.lock().unwrap_or_else(|p| p.into_inner());
+        if wire_bytes == 0
+            || self
+                .work
+                .pacing
+                .as_ref()
+                .is_some_and(|p| now >= p.expires_at)
+        {
+            *state = Decision::Rejected;
+            return WorkAdmission::Rejected;
+        }
+        let Decision::Admitted {
+            owner: bound,
+            packet_costs,
+            ..
+        } = &mut *state
+        else {
+            return WorkAdmission::Rejected;
+        };
+        if *bound != owner {
+            *state = Decision::Rejected;
+            return WorkAdmission::Rejected;
+        }
+        if let Some(paid) = packet_costs[self.index] {
+            if paid == wire_bytes {
+                return WorkAdmission::Admitted;
+            }
+            // A changed frame/transport shape cannot reuse the old charge.
+            *state = Decision::Rejected;
+            return WorkAdmission::Rejected;
+        }
+        match reserve(wire_bytes) {
+            Ok(()) => {
+                packet_costs[self.index] = Some(wire_bytes);
+                WorkAdmission::Admitted
+            }
+            Err(until) => WorkAdmission::Wait(until),
+        }
+    }
