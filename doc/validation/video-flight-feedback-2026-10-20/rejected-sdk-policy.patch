+    fn data_delay_preserves_video_flight_but_audio_pressure_still_contracts_it() {
+        use crate::local_source_flight::Role;
+        let source = LocalSourceActivity::default();
+        let now = Instant::now();
+        let primary = (source.flight.factory(Role::Primary))(1);
+        let video = (source.flight.factory(Role::Secondary))(2);
+        source.note(now);
+        source.note_feedback(false, now);
+        video.blocked(now);
+        let first_ack = now + Duration::from_millis(100);
+        primary.delivered(first_ack, now, 2400, Duration::from_millis(100));
+        let earned = video.window(first_ack, 0, 1200);
+        assert_eq!(earned, 3601);
+        source.note_reliable_transport_pressure(first_ack);
+        assert_eq!(
+            video.window(first_ack, 0, 1200),
+            earned,
+            "DATA-only delay must not contract video's paid flight window"
+        );
+        video.blocked(first_ack);
+        let next_ack = first_ack + Duration::from_millis(100);
+        source.note_feedback(false, next_ack);
+        primary.delivered(next_ack, first_ack, 3600, Duration::from_millis(100));
+        assert!(
+            video.window(next_ack, 0, 1200) > earned,
+            "DATA-only delay must not erase healthy media delivery feedback"
+        );
+        source.note_pressure(next_ack);
+        assert!(
+            video.window(next_ack, 0, 1200) < earned,
+            "genuine shared audio pressure retains its protection"
+        );
+    }
