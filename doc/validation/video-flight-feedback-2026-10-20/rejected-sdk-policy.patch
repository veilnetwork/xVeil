+    fn each_growth_requires_a_new_healthy_feedback_not_only_first_hop_acks() {
+        let now = Instant::now();
+        let pool = Arc::new(SourceFlightPool::default());
+        let primary = pool.binding(1, Role::Primary, now).unwrap();
+        let video = pool.binding(2, Role::Secondary, now).unwrap();
+        pool.note_primary(now);
+        for step in 0..10 {
+            pool.feedback(false, now + Duration::from_millis(step));
+        }
+        let first = now + Duration::from_millis(100);
+        video.blocked(first);
+        primary.delivered(first, now, 2400, Duration::from_millis(50));
+        assert_eq!(video.window(first, 0, 1200), 3601);
+        video.blocked(first);
+        let later = first + Duration::from_millis(100);
+        primary.delivered(later, first, 6000, Duration::from_millis(50));
+        assert_eq!(
+            video.window(later, 0, 1200),
+            3601,
+            "first-hop ACKs cannot spend one audio observation repeatedly"
+        );
+        pool.feedback(false, later);
+        assert_eq!(
+            video.window(later, 0, 1200),
+            3601,
+            "feedback alone does not manufacture delivery progress"
+        );
+        let confirmed = later + Duration::from_millis(100);
+        primary.delivered(confirmed, later, 3600, Duration::from_millis(50));
+        assert_eq!(video.window(confirmed, 0, 1200), 4801);
+    }
+
