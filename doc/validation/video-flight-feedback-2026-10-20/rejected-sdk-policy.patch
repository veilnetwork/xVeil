+        pool.note_primary(now);
+        pool.feedback(false, now);
+        video.blocked(now);
+        primary.delivered(now, now, 2400, Duration::from_millis(120));
+        let early = now + Duration::from_millis(1);
+        pool.feedback(false, early);
+        video.blocked(early);
+        primary.delivered(early, now, 3600, Duration::from_millis(120));
+        assert_eq!(video.window(early, 0, 1200), 3601);
+        let later = now + Duration::from_millis(120);
+        primary.delivered(later, early, 3600, Duration::from_millis(120));
+        assert_eq!(video.window(later, 0, 1200), 4801);
+    }
