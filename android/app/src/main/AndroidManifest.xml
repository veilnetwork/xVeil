<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Camera is used ONLY to scan a contact's invite QR; declared optional so
         the app still installs on camera-less devices (paste remains). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- Local notifications for incoming messages (Android 13+ runtime grant). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Microphone for calls (veil audio engine, AAudio capture). Runtime grant;
         requested when a call goes active, not at startup. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Keep Wi-Fi out of DTIM/power-save batching only while a live call is
         active. The lock is acquired by MainActivity through a private
         MethodChannel and released with the call/Activity lifecycle. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Screen sharing is explicit, user-consented MediaProjection. Android
         14+ requires both the generic and typed foreground-service grants. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- Battery-optimisation exemption: lets the keep-alive foreground service
         actually keep the node receiving in the background (Doze + aggressive
         OEMs suspend the process otherwise). Requested only when the user opts
         into "keep node in background" — never at startup. -->
    <uses-permission
        android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <application
        android:label="xveil"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:networkSecurityConfig="@xml/network_security_config"
        android:fullBackupContent="false">
        <!-- Deniability: never let the encrypted container or any app data leave
             the device. allowBackup=false disables cloud + `adb backup` on every
             API level; data_extraction_rules additionally excludes the Android-12+
             device-to-device transfer path (which allowBackup alone does not). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:resizeableActivity="true"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <service
            android:name=".ScreenCaptureService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            android:stopWithTask="true" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Opening a tapped message link in the system browser (url_launcher);
             Android 11+ needs the target intent declared to be visible. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="http"/>
        </intent>
    </queries>
</manifest>
